         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The peopleremover -- removing dynamic objects from 3D point cloud data by traversing a voxel occupancy grid</rdf:li>
            </rdf:Alt>
         </dc:title>
